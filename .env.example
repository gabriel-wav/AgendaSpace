# ─── AgendaSpace — Variáveis de Ambiente (Exemplo) ─────────────────────────
# Instruções:
# 1. Copie este arquivo: cp .env.example .env
# 2. Preencha com os dados do seu ambiente local.
# 3. NUNCA envie credenciais de produção ou senhas reais para o Git.
#
# Arquitetura: NestJS (backend, porta 3000) + Vite/React (frontend, porta 8080)
# Bancos: MySQL 8+ via Prisma ORM | MongoDB 6+ via Mongoose (Feed)

# ─── Servidor Backend NestJS ──────────────────────────────────────────────────
PORT=3000

# ─── Cliente Frontend Vite / React ───────────────────────────────────────────
# URL do backend NestJS acessível pelo navegador
VITE_API_URL=http://localhost:3000

# ─── Configuração de CORS ─────────────────────────────────────────────────────
# Origem do frontend — usada pelo NestJS para liberar requisições cross-origin
FRONTEND_URL=http://localhost:8080

# ─── Banco de Dados Relacional (MySQL / MariaDB via Prisma) ──────────────────
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
# Migrations incrementais: npx prisma migrate deploy  (NÃO use migrate reset em produção)
DATABASE_URL="mysql://usuario:senha@localhost:3306/agendaspace"

# ─── Banco de Dados NoSQL (MongoDB via Mongoose para Feed) ───────────────────
# Local:  mongodb://localhost:27017/agendaspace
# Atlas:  mongodb+srv://usuario:senha@cluster.mongodb.net/agendaspace?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017/agendaspace"

# ─── Autenticação e Segurança (JWT) ───────────────────────────────────────────
# Chave secreta de alta entropia — mínimo 32 caracteres alfanuméricos
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="sua_chave_secreta_jwt_deve_ter_pelo_menos_32_caracteres"

# ─── Conta ADMIN inicial (usada pelo seed) ────────────────────────────────────
# O registro público NUNCA aceita role ADMIN — use este seed para criar o primeiro admin.
# Execute: npx ts-node prisma/seed.ts
ADMIN_EMAIL="admin@agendaspace.local"
ADMIN_PASSWORD="Admin@123456"
ADMIN_FULL_NAME="Administrador"
